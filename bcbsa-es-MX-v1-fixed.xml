<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
      alphabet="ipa" xml:lang="es-MX">

  <!-- ==========================================
       BCBSA Brand Name - Full and Short Forms
       ========================================== -->

  <!-- Full phrase from the closing script -->
  <lexeme>
    <grapheme>Blue Cross Blue Shield Global Solutions</grapheme>
    <grapheme>blue cross blue shield global solutions</grapheme>
    <grapheme>BLUE CROSS BLUE SHIELD GLOBAL SOLUTIONS</grapheme>
    <alias>Blu Cros Blu Shild Glóbal Solúshons</alias>
  </lexeme>

  <!-- Short form -->
  <lexeme>
    <grapheme>Blue Cross Blue Shield</grapheme>
    <grapheme>blue cross blue shield</grapheme>
    <grapheme>Blue Cross y Blue Shield</grapheme>
    <grapheme>BLUE CROSS BLUE SHIELD</grapheme>
    <alias>Blu Cros Blu Shild</alias>
  </lexeme>

  <!-- Acronyms -->
  <lexeme>
    <grapheme>BCBSA</grapheme>
    <alias>Blu Cros Blu Shild Asosiéishon</alias>
  </lexeme>
  <lexeme>
    <grapheme>BCBS</grapheme>
    <alias>Blu Cros Blu Shild</alias>
  </lexeme>

